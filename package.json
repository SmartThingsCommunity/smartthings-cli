{
	"name": "@smartthings/cli",
	"version": "2.1.2",
	"description": "Command Line Interface for the SmartThings APIs",
	"keywords": [
		"smartthings",
		"cli"
	],
	"homepage": "https://github.com/SmartThingsCommunity/smartthings-cli",
	"author": "Samsung Electronics Co., LTD.",
	"bugs": {
		"url": "https://github.com/SmartThingsCommunity/smartthings-cli/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SmartThingsCommunity/smartthings-cli.git"
	},
	"files": [
		"bin",
		"dist/src",
		"dist/tsconfig.tsbuildinfo",
		"README.md",
		"package.json",
		"/npm-shrinkwrap.json",
		"!*/src/build-tools",
		"!*/src/__tests__"
	],
	"main": "./dist/src/index.js",
	"bin": {
		"smartthings": "dist/src/run.js"
	},
	"exports": {
		".": "./dist/src/index.js",
		"./*": "./dist/src/lib/*.js",
		"./commands/list": "./dist/src/commands/index.js"
	},
	"engines": {
		"node": ">=24.8.0",
		"npm": ">=11.4.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-lambda": "^3.1114.0",
		"@inquirer/prompts": "^8.6.0",
		"@smartthings/core-sdk": "^8.5.4",
		"axios": "1.19.0",
		"chalk": "^6.0.0",
		"env-paths": "^4.0.0",
		"eventsource": "^5.1.0",
		"express": "^5.2.1",
		"get-port-please": "^3.2.0",
		"js-yaml": "^5.3.0",
		"jszip": "^3.10.1",
		"lodash.at": "^4.6.0",
		"log4js": "^6.9.1",
		"open": "^11.0.1",
		"ora": "^9.4.1",
		"os-locale": "^8.0.0",
		"picomatch": "^4.0.5",
		"qs": "^6.15.3",
		"table": "^6.9.0",
		"ts-node": "^10.9.2",
		"tslib": "^2.8.1",
		"tsx": "^4.23.12",
		"undici": "^8.10.0",
		"uuid": "^14.0.2",
		"yargs": "^18.1.0"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@changesets/release-utils": "^1.0.0",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/archiver": "^8.0.0",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/js-yaml": "^4.0.9",
		"@types/lodash.at": "^4.6.9",
		"@types/node": "^24.13.3",
		"@types/picomatch": "^4.0.3",
		"@types/qs": "^6.15.1",
		"@types/yargs": "^17.0.35",
		"@vercel/ncc": "^0.45.0",
		"archiver": "^8.0.0",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "^10.8.1",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-jest": "^29.16.1",
		"globals": "^17.11.0",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"jest-extended": "^7.0.0",
		"jest-html-reporters": "^3.1.7",
		"mock-stdin": "^1.0.0",
		"nexe": "^5.0.0-beta.4",
		"rimraf": "^6.1.3",
		"strip-ansi": "^7.2.0",
		"ts-jest": "^29.4.12",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.67.0"
	},
	"scripts": {
		"lint": "eslint src",
		"format": "eslint src --fix",
		"clean": "rimraf dist && rimraf tsconfig.tsbuildinfo",
		"full-clean": "rimraf dist_bin && rimraf coverage && rimraf jest*html* && npm run clean && rimraf node_modules",
		"compile": "tsc",
		"readme": "tsx dist/src/build-tools/update-readme.js",
		"watch": "tsc -w --sourceMap",
		"build": "npm run clean && npm run compile && npm run readme",
		"debug-build": "npm run clean && tsc --sourceMap && npm run readme",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
		"test-watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch --reporters=default",
		"test-coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage=true",
		"prepack": "tsc && npm run readme",
		"version": "npm run build && npm run readme && git add README.md && changeset version && npm i --package-lock-only && npm run compile",
		"release": "npm run build && changeset publish",
		"package": "tsx src/build-tools/build-binaries.ts"
	},
	"directories": {
		"doc": "doc"
	}
}
